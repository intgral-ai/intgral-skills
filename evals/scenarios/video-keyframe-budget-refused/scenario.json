            "summary": "Reserve one keyframe slot (segment_index, position) against the authorized frame budget; authorized_budget raises the authorized total",
            "request_schema": {
              "type": "object",
              "required": [
                "segment_index",
                "position"
              ],
              "additionalProperties": false,
              "properties": {
                "segment_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "position": {
                  "enum": [
                    "first",
                    "last"
                  ]
                },
                "authorized_budget": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "New authorized frame total"
                }
              }
            }
