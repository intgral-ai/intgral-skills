    {
      "name": "medusa.list_endpoints",
      "description": "List the Medusa admin API routes the passthrough tools can call. Filter by path prefix, method or source.",
      "inputSchema": {
        "prefix": "string?",
        "method": "string?",
        "source": "string?"
      },
      "responses": [
        {
          "result": {
            "total": 9,
            "endpoints": [
              {
                "method": "GET",
                "path": "/admin/amazon/listings",
                "source": "custom",
                "summary": "Amazon listings; filter by seller_sku, marketplace_id, store_id; view=all for every listing (default: the review queue)."
              },
              {
                "method": "GET",
                "path": "/admin/products/:id/aplus-images",
                "source": "custom",
                "summary": "The product's stored A+ Content images, newest first: id, module, locale, url, width, height, created_at."
              },
              {
                "method": "GET",
                "path": "/admin/products/:id/aplus-pages",
                "source": "custom",
                "summary": "The product's A+ pages (one per store and marketplace) with modules, ASINs, status and latest plan."
              },
              {
                "method": "POST",
                "path": "/admin/products/:id/aplus-pages",
                "source": "custom",
                "summary": "Save (create or replace) the product's A+ page draft for one store and marketplace. Returns the page and structure findings."
              },
              {
                "method": "POST",
                "path": "/admin/aplus-pages/:id/plans",
                "source": "custom",
                "summary": "Human with the owning store's publication grant: freeze the page into a plan and run Amazon's check (image upload, dry-run validation)."
              },
              {
                "method": "POST",
                "path": "/admin/aplus-plans/:id/confirmations",
                "source": "custom",
                "summary": "Human only: mint the single-use publish confirmation for a checked plan, with the no-AI-people attestation."
              },
              {
                "method": "POST",
                "path": "/admin/aplus-plans/:id/publish",
                "source": "custom",
                "summary": "Human only: publish a confirmed A+ plan to Amazon."
              },
              {
                "method": "GET",
                "path": "/admin/aplus-plans/:id/status",
                "source": "custom",
                "summary": "The plan's progress and Amazon review status."
              },
              {
                "method": "POST",
                "path": "/admin/aplus-plans/:id/status/refresh",
                "source": "custom",
                "summary": "Human only: re-read Amazon's review status (at most hourly)."
              }
            ]
          }
        }
      ]
    },
