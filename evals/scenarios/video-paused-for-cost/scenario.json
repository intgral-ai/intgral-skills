    {
      "name": "medusa.list_endpoints",
      "description": "The admin API catalog: this ERP's own routes with their request schemas, and Medusa's core routes.",
      "inputSchema": {
        "prefix": "string?",
        "method": "GET|POST|PATCH|PUT|DELETE?",
        "source": "custom|core?"
      },
      "responses": [
        {
          "result": {
            "total": 11,
            "endpoints": [
              {
                "method": "GET",
                "path": "/admin/video-generations",
                "source": "custom",
                "summary": "List video generations, filterable by product_id and status"
              },
              {
                "method": "POST",
                "path": "/admin/video-generations",
                "source": "custom",
                "summary": "Create a video generation draft (reference or keyframe mode); returns plan_hash and a sourced estimate. A new paid attempt once approved"
              },
              {
                "method": "GET",
                "path": "/admin/video-generations/:id",
                "source": "custom",
                "summary": "One video generation: status, stage, plan_hash, estimate, cost_cap, spend (spent/held/cap), pause, failure, segments with attempts, keyframes, frame_budget, media_asset_ids"
              },
              {
                "method": "POST",
                "path": "/admin/video-generations/:id/approve",
                "source": "custom",
                "summary": "Approve the current plan: plan_hash must equal the current plan_hash (409 otherwise), cost_cap in the estimate currency and at least the estimate. Freezes the snapshot and queues generation"
              },
              {
                "method": "POST",
                "path": "/admin/video-generations/:id/pause",
                "source": "custom",
                "summary": "Register a pause: already submitted segments continue, later submissions stop"
              },
              {
                "method": "POST",
                "path": "/admin/video-generations/:id/resume",
                "source": "custom",
                "summary": "Resume paused work, or a failure whose retry_action is resume; an optional cost_cap raises the cap"
              },
              {
                "method": "POST",
                "path": "/admin/video-generations/:id/keyframes/reservations",
                "source": "custom",
                "summary": "Reserve one keyframe slot (segment_index, position) against the authorized frame budget; authorized_budget raises the authorized total"
              },
              {
                "method": "POST",
                "path": "/admin/video-generations/:id/keyframes",
                "source": "custom",
                "summary": "Store a generated keyframe image for a reserved slot"
              },
              {
                "method": "POST",
                "path": "/admin/video-generations/:id/keyframes/:keyframe_id/review",
                "source": "custom",
                "summary": "Record the user's review of a keyframe version: approved, rejected or accepted_with_issues"
              },
              {
                "method": "GET",
                "path": "/admin/products/:id/videos",
                "source": "custom",
                "summary": "Stored product video assets and the selected version"
              },
              {
                "method": "POST",
                "path": "/admin/video-assets/:id",
                "source": "custom",
                "summary": "Mark a video version as selected, or record its quality verdict"
              }
            ]
          }
        }
      ]
