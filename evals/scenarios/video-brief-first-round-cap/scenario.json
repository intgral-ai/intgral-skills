    {
      "name": "host.open_url",
      "description": "Open a URL in the user's browser. Host tool, not an Intgral MCP tool.",
      "inputSchema": {
        "url": "string"
      },
      "responses": [
        {
          "result": {
            "opened": true
          }
        }
