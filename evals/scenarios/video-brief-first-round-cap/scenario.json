    {
      "name": "medusa.list_endpoints",
      "description": "List the admin routes the passthrough tools can call.",
      "inputSchema": {
        "prefix": "string?",
        "method": "string?",
        "source": "string?"
      },
      "responses": [
        {
          "result": {
            "endpoints": [
              {
                "method": "POST",
                "path": "/admin/video-generations",
                "source": "custom",
                "summary": "Freeze one SKU's video request into a drafting job. The draft carries the backend's estimate (amount, currency, price source) or null when unknown. Creating a draft is free; nothing is generated or charged until an approval with a cost cap."
              },
              {
                "method": "GET",
                "path": "/admin/video-generations/:id",
                "source": "custom",
                "summary": "One generation with its plan, plan_hash, estimate and status."
              },
              {
                "method": "POST",
                "path": "/admin/video-generations/:id/approve",
                "source": "custom",
                "summary": "Approve the reviewed plan_hash with a cost cap; starts paid generation."
              },
              {
                "method": "GET",
                "path": "/admin/products/:id/videos",
                "source": "custom",
                "summary": "A product's video assets."
              },
              {
                "method": "GET",
                "path": "/admin/products/:id",
                "source": "core",
                "summary": "Product detail: description, images, variants and the listing profile (bullet points)."
              }
            ]
          }
        }
      ]
    },
    {
      "name": "medusa.describe_endpoint",
      "description": "The request schema and summary of one admin route.",
      "inputSchema": {
        "method": "string",
        "path": "string"
      },
      "responses": [
        {
          "result": {
            "method": "POST",
            "path": "/admin/video-generations",
            "summary": "Freeze one SKU's video request into a drafting job. The draft carries the backend's estimate (amount, currency, price source) or null when unknown. Creating a draft is free; nothing is generated or charged until an approval with a cost cap.",
            "body": {
              "product_id": "string",
              "variant_id": "string",
              "prompt": "string",
              "duration_seconds": "integer 4–35",
              "aspect_ratio": "9:16 | 16:9 | 1:1 | …",
              "resolution": "768P | 2K",
              "reference_asset_ids": "string[]?",
              "idempotency_key": "string"
            }
          }
        }
      ]
    },
    {
      "name": "medusa.admin_get",
      "description": "Call GET on a permitted admin route. Inert.",
