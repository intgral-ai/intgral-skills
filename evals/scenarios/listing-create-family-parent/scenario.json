    {
      "name": "medusa.list_endpoints",
      "description": "List the Medusa admin API routes the passthrough tools can call — this ERP's own routes (source: custom, with request schemas) and Medusa's core routes (source: core). Filter by path prefix, method or source; read one route's schema with medusa.describe_endpoint.",
      "inputSchema": {
        "prefix": "string?",
        "method": "GET|POST|PATCH|PUT|DELETE?",
        "source": "custom|core?"
      },
      "responses": [
        {
          "result": {
            "total": 7,
            "endpoints": [
              {
                "method": "GET",
                "path": "/admin/products/:id",
                "source": "core",
                "summary": "Product detail"
              },
              {
                "method": "GET",
                "path": "/admin/amazon/stores",
                "source": "custom",
                "summary": "The Amazon stores (店铺): every marketplace_connection row with its participations, display name and which store is the resolved default. Never exposes credential references."
              },
              {
                "method": "GET",
                "path": "/admin/marketplace/listings/:id",
                "source": "custom",
                "summary": "Listing detail"
              },
              {
                "method": "GET",
                "path": "/admin/marketplace/listings/:id/site-offer-price",
                "source": "custom",
                "summary": "Read the current Site-specific offer price (the Decision 6 override) for one marketplace listing, or null. Read-only; never a publication action."
              },
              {
                "method": "GET",
                "path": "/admin/marketplace/listings/:id/fbm-policy",
                "source": "custom",
                "summary": "Read the current per-listing FBM stock policy (the Decision 5 supply designation) of one marketplace listing — the designated supply locations, safety stock, channel publication cap and shipping configuration — or null. Read-only; never a publication action."
              },
              {
                "method": "POST",
                "path": "/admin/marketplace/listings/:id/content",
                "source": "custom",
                "summary": "Save a listing's desired copy"
              },
              {
                "method": "POST",
                "path": "/admin/marketplace/listings/:id/attributes",
                "source": "custom",
                "summary": "Save a listing's attributes"
              }
            ]
          }
        }
      ]
    },
