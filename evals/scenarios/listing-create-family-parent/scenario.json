    {
      "name": "medusa.update_product",
      "description": "The draft PRODUCT's one write door (follow the installed Intgral listing skill, intgral-listing): patch requested product copy, profile fields, per-SKU prices and images — only what the patch names changes. Listing edits use update_listing. Inspect write_result even on isError. Earlier confirmed writes remain; there is no atomic rollback. Retry only pending work when next_action is retry_pending. For read_state_before_retry, read current state before deciding further writes. Returned inventory/compliance on errors is the last confirmed snapshot. Image indexes refer to the original input. completed_image_indexes confirms batch completion; image_reports determines which images were stored or rejected. Never publishes.",
      "inputSchema": {
        "product_id": "string",
        "price_source": "user|sheet?",
        "title": "string?",
        "description": "string?",
        "profile": "object?",
        "prices": "array?",
        "add_variants": "object?",
        "remove_image_urls": "array?",
        "images": "array?"
      },
      "responses": [
        {
          "when": {
            "product_id": "prod_rs9001",
            "price_source": "user"
          },
          "result": {
            "product_id": "prod_rs9001",
            "write_result": {
              "status": "succeeded",
              "completed_steps": [
                "batch_1"
              ],
              "pending_steps": [],
              "unknown_steps": [],
              "next_action": "none"
            },
            "draft": {
              "product_id": "prod_rs9001",
              "erp_url": "https://erp.example.test/app/products/prod_rs9001",
              "updated": {
                "product": false,
                "profile": false,
                "prices": 2,
                "images": 0
              },
              "image_reports": []
            }
          }
        },
        {
          "when": {
            "product_id": "prod_rs9001",
            "price_source": "sheet"
          },
          "result": {
            "product_id": "prod_rs9001",
            "write_result": {
              "status": "succeeded",
              "completed_steps": [
                "batch_1"
              ],
              "pending_steps": [],
              "unknown_steps": [],
              "next_action": "none"
            },
            "draft": {
              "product_id": "prod_rs9001",
              "erp_url": "https://erp.example.test/app/products/prod_rs9001",
              "updated": {
                "product": false,
                "profile": false,
                "prices": 2,
                "images": 0
              },
              "image_reports": []
            }
          }
        },
        {
          "when": {
            "product_id": "prod_rs9001"
          },
          "error": {
            "code": "invalid_arguments",
            "message": "Patching prices needs their source: pass price_source \"user\" or \"sheet\". A price is a fact only the user knows — never fill in an example or estimated price; when it is missing, ask. Still needed: the price."
          }
        },
        {
          "error": {
            "code": "not_found",
            "message": "No product matches the identifier",
            "request_id": "req_mock_nf"
