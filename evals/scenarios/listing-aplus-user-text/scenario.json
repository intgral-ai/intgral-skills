      "medusa.update_product": {
        "allowed_args": [
          "product_id",
          "title",
          "images"
        ]
      },
      "medusa.update_listing": {
        "allowed_args": [
          "listing_id",
          "title",
          "images"
        ]
      }
    },
    "reads": [
      "medusa.get_product",
      "medusa.view_product_images"
    ],
    "forbidden_tools": [],
    "forbidden_writes": [
      {
        "label": "A+ image stored through medusa.update_product (the Amazon listing gallery)",
        "tool": "medusa.update_product",
        "args": {
          "images": "*"
        }
      },
      {
        "label": "A+ image stored through medusa.update_listing (the Amazon listing gallery)",
        "tool": "medusa.update_listing",
        "args": {
          "images": "*"
        }
      }
    ],
    "order": [
      {
        "label": "A+ image generated before the product photos were looked up",
        "first": {
          "tool": "medusa.view_product_images",
          "args": {}
        },
        "then": {
          "tool": "host.generate_image",
          "args": {}
        }
      },
      {
        "label": "A+ image stored before the host generated one",
        "first": {
          "tool": "host.generate_image",
          "args": {}
        },
        "then": {
          "tool": "medusa.attach_aplus_images",
          "args": {}
        }
