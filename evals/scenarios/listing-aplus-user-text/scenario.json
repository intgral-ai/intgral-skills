          "images": {
            "$contains": [
              {
                "module": "STANDARD_HEADER_IMAGE_TEXT",
                "locale": "es-ES"
              }
            ]
          }
        }
      }
    ],
    "max_tool_calls": 5,
    "max_calls": {
      "host.generate_image": 1,
      "medusa.attach_aplus_images": 1
    }
  },
  "rubric": [
    "The image carries the user's wording exactly (\"Orden en tu entrada\"), handed to generation unchanged; the agent adds no copy of its own and asks no second question after the confirmation.",
